generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String          @unique
  passwordHash String
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tickets      Ticket[]
  messages     TicketMessage[]
  sentMessages TicketMessage[] @relation("TicketMessagesSender")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Service {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String
  tagline     String?
  description String
  priceStart  String?
  featured    Boolean    @default(false)
  sortOrder   Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("services")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  image       String?
  tags        String   @default("")
  link        String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Asset {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}

model TextBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("text_blocks")
}

model TeamMember {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  logo        String?  // Changed from avatar to logo
  bio         String?
  socials     Json?    // Changed to Json for flexible social links
  services    String?
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Product {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  serviceId  String
  description String
  price      String?
  fileUrl    String?
  featured   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("products")
}

enum PlanLevel {
  REGULAR
  PREMIUM
  BIGNESS
}

model Plan {
  id          String   @id @default(cuid())
  serviceSlug String
  level       PlanLevel @default(REGULAR)
  title       String
  price       String
  description String
  features    String
  recommended Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plans")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      TicketStatus   @default(OPEN)
  category    String?
  priority    TicketPriority @default(MEDIUM)
  userId      String
  userAgent   String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
  adminReply  String?        // Admin's reply to customer

  @@map("tickets")
}

model TicketMessage {
  id          String    @id @default(cuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  senderId    String    // User ID of the sender
  content     String    // Message text
  role        TicketRole
  createdAt   DateTime  @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      User @relation("TicketMessagesSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

enum TicketRole {
  CUSTOMER
  ADMIN
}
